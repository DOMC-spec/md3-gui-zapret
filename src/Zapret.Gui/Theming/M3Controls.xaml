<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <FontFamily x:Key="M3.Font">pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto</FontFamily>

 <Style x:Key="M3.Body" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource M3.Font}"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="20"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}"/>
 </Style>
 <Style x:Key="M3.Supporting" TargetType="TextBlock" BasedOn="{StaticResource M3.Body}">
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}"/>
 </Style>
 <Style x:Key="M3.Label" TargetType="TextBlock" BasedOn="{StaticResource M3.Supporting}">
  <Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="16"/>
  <Setter Property="FontWeight" Value="Medium"/>
 </Style>
 <Style x:Key="M3.Title" TargetType="TextBlock" BasedOn="{StaticResource M3.Body}">
  <Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="24"/><Setter Property="FontWeight" Value="Medium"/>
 </Style>
 <Style x:Key="M3.Headline" TargetType="TextBlock" BasedOn="{StaticResource M3.Body}">
  <Setter Property="FontSize" Value="24"/><Setter Property="LineHeight" Value="32"/>
 </Style>

 <!-- 40dp visual container in a 48dp pointer/keyboard target. -->
 <Style x:Key="M3.Button" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource M3.Font}"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Height" Value="48"/><Setter Property="MinWidth" Value="64"/>
  <Setter Property="Padding" Value="24,0"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.Primary}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Border x:Name="Container" Margin="0,4" CornerRadius="20" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
     <Border x:Name="StateLayer" Margin="0,4" CornerRadius="20" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False"/>
     <Border x:Name="FocusRing" Margin="-3,1" CornerRadius="23" BorderBrush="{DynamicResource M3.Primary}" BorderThickness="3" Visibility="Collapsed" IsHitTestVisible="False"/>
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
      VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StateLayer" Property="Opacity" Value=".08"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StateLayer" Property="Opacity" Value=".10"/><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="StateLayer" Property="Opacity" Value=".10"/></Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}"/>
      <Setter TargetName="Content" Property="Opacity" Value=".38"/>
      <Setter TargetName="Container" Property="Opacity" Value=".12"/>
      <Setter TargetName="StateLayer" Property="Opacity" Value="0"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="M3.FilledButton" TargetType="Button" BasedOn="{StaticResource M3.Button}">
  <Setter Property="Background" Value="{DynamicResource M3.Primary}"/><Setter Property="Foreground" Value="{DynamicResource M3.OnPrimary}"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource M3.OnSurface}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="M3.TonalButton" TargetType="Button" BasedOn="{StaticResource M3.Button}">
  <Setter Property="Background" Value="{DynamicResource M3.SecondaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource M3.OnSecondaryContainer}"/>
 </Style>
 <Style x:Key="M3.OutlinedButton" TargetType="Button" BasedOn="{StaticResource M3.Button}">
  <Setter Property="BorderBrush" Value="{DynamicResource M3.Outline}"/><Setter Property="BorderThickness" Value="1"/>
 </Style>
 <Style x:Key="M3.DestructiveButton" TargetType="Button" BasedOn="{StaticResource M3.OutlinedButton}">
  <Setter Property="Foreground" Value="{DynamicResource M3.Error}"/>
 </Style>
 <Style x:Key="M3.IconButton" TargetType="Button" BasedOn="{StaticResource M3.Button}">
  <Setter Property="Width" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="0"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}"/>
 </Style>

 <Style x:Key="M3.ThemeToggle" TargetType="ToggleButton">
  <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Border x:Name="State" Margin="4" CornerRadius="20" Background="{DynamicResource M3.OnSurfaceVariant}" Opacity="0"/>
    <md:PackIcon x:Name="Icon" Kind="WeatherNight" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="Focus" Margin="1" CornerRadius="23" BorderBrush="{DynamicResource M3.Primary}" BorderThickness="3" Visibility="Collapsed"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Icon" Property="Kind" Value="WhiteBalanceSunny"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value=".08"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Opacity" Value=".10"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="M3.TabItem" TargetType="TabItem">
  <Setter Property="FontFamily" Value="{StaticResource M3.Font}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Grid Height="64" Background="Transparent">
    <Border x:Name="State" Background="{DynamicResource M3.Primary}" Opacity="0"/>
    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="Indicator" Width="96" Height="3" Background="{DynamicResource M3.Primary}" CornerRadius="3,3,0,0" VerticalAlignment="Bottom" Visibility="Collapsed"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource M3.Primary}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value=".08"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="State" Property="Opacity" Value=".10"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="M3.Tabs" TargetType="TabControl">
  <Setter Property="Background" Value="{DynamicResource M3.Surface}"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource M3.TabItem}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource M3.OutlineVariant}" BorderThickness="0,0,0,1"/>
    <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,16,0,0"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="M3.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
  <Setter Property="FontFamily" Value="{StaticResource M3.Font}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Height" Value="56"/><Setter Property="Padding" Value="16,0"/>
  <Setter Property="Background" Value="{DynamicResource M3.Surface}"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource M3.Outline}"/>
  <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="4"/>
 </Style>
 <Style x:Key="M3.TextField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
  <Setter Property="FontFamily" Value="{StaticResource M3.Font}"/><Setter Property="FontSize" Value="16"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Height" Value="56"/><Setter Property="Padding" Value="16,0"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}"/>
  <Setter Property="Background" Value="{DynamicResource M3.Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource M3.Outline}"/>
  <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="4"/>
 </Style>
 <Style x:Key="M3.Switch" TargetType="ToggleButton">
  <Setter Property="Width" Value="52"/><Setter Property="Height" Value="48"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid Background="Transparent">
    <Border x:Name="Track" Height="32" CornerRadius="16" VerticalAlignment="Center" BorderThickness="2"
     BorderBrush="{DynamicResource M3.Outline}" Background="{DynamicResource M3.SurfaceContainerHighest}"/>
    <Border x:Name="Halo" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left" Margin="-4,0,0,0"
     Background="{DynamicResource M3.Primary}" Opacity="0"/>
    <Border x:Name="Handle" Width="16" Height="16" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Center"
     Margin="8,0,0,0" Background="{DynamicResource M3.Outline}">
     <md:PackIcon x:Name="Check" Kind="Check" Width="16" Height="16" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
      Foreground="{DynamicResource M3.OnPrimaryContainer}"/>
    </Border>
    <Border x:Name="Focus" Height="38" Margin="-3,0" CornerRadius="19" BorderThickness="3"
     BorderBrush="{DynamicResource M3.Primary}" Visibility="Collapsed"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Track" Property="Background" Value="{DynamicResource M3.Primary}"/>
     <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource M3.Primary}"/>
     <Setter TargetName="Handle" Property="Background" Value="{DynamicResource M3.OnPrimary}"/>
     <Setter TargetName="Handle" Property="Width" Value="24"/><Setter TargetName="Handle" Property="Height" Value="24"/>
     <Setter TargetName="Handle" Property="Margin" Value="24,0,0,0"/>
     <Setter TargetName="Halo" Property="Margin" Value="16,0,0,0"/>
     <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Halo" Property="Opacity" Value=".08"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Halo" Property="Opacity" Value=".10"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
